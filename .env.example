# Required: bot token (Discord Developer Portal > Bot > Reset Token)
BOT_TOKEN=

# Optional: server ID. Commands are registered instantly in this server (great for testing)
GUILD_ID=

# Optional: channel where moderation actions, AutoMod alerts and closed tickets are logged
MOD_LOG_CHANNEL_ID=

# Optional: channel for event logs (deleted/edited messages, members joining/leaving)
EVENT_LOG_CHANNEL_ID=
# Optional: set to true to show the text of deleted/edited messages in the event logs
# (requires the privileged "Message Content Intent" enabled in the Developer Portal)
LOG_MESSAGE_CONTENT=

# Optional: channel for welcome messages
WELCOME_CHANNEL_ID=

# Optional: role given to every new member
AUTOROLE_ROLE_ID=

# Optional: channel where /suggest posts suggestions (default: the channel where it was used)
SUGGESTIONS_CHANNEL_ID=

# Optional: category where tickets are created
TICKETS_CATEGORY_ID=
# Optional but recommended: role that can see and close tickets
TICKETS_STAFF_ROLE_ID=

# Optional: webhook that receives error logs
WEBHOOK_LOGS_URL=

NODE_OPTIONS=
